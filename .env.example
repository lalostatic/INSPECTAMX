# App
VITE_APP_URL=https://inspectamx.com
VITE_API_URL=https://api.inspectamx.com

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=https://inspectamx.com

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# D1
D1_DATABASE_ID=your-d1-database-id

# R2
R2_BUCKET_NAME=inspectamx-media
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_PUBLIC_URL=https://media.inspectamx.com

# KV
KV_NAMESPACE_ID=your-kv-namespace-id

# Neon Postgres (reports)
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/inspectamx

# Dev mode
NODE_ENV=development
